# Configuración de Preparar tests
DIRECTORIO_APUNTES="/home/natalia/Escritorio/apuntes-privados"
PUERTO_WEB=3000
# ============================================================
# PROVEEDOR DE INTELIGENCIA ARTIFICIAL (IA)
# Opciones: "auto" (prueba Ollama primero y fallback a NVIDIA), "ollama" o "nvidia"
# ============================================================
PROVEEDOR_IA="auto"

# Modelo local de Ollama (para desarrollo en tu máquina)
MODELO_IA=qwen2.5vl:7b
NUM_CTX_IA=24576
TOKENS_MAX_IA=2048
TIEMPO_IA=900
MAX_CARACTERES_BLOQUE=10000

# ============================================================
# NVIDIA NIM (build.nvidia.com) - Gratuito (~40 req/min)
# Más de 120 modelos abiertos: DeepSeek R1, Qwen 2.5 72B, Llama 3.1, etc.
# Funciona en desarrollo y desplegado en web / GitHub sin depender de Ollama local
# ============================================================
NVIDIA_API_KEY=""
NVIDIA_MODELO="meta/llama-3.1-8b-instruct"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# ============================================================
# SUPABASE (Mismo proyecto que Acceso Grados Informáticos)
# ============================================================
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="tu-clave-anon-supabase"

# ============================================================
# GITHUB (Repositorio privado con las preguntas y apuntes)
# ============================================================
GITHUB_REPOSITORY="nataliagamezbarea/GRADOS_INFORMATICOS"
GITHUB_BRANCH="Segundo_grado_superior"
GITHUB_FOLDER="datos/bancos/WEC"

# Token de acceso personal de GitHub (Classic o Fine-grained con permiso de lectura de repositorios)
GH_TOKEN=""
