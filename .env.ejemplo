# Configuración de Preparar tests
DIRECTORIO_APUNTES="/home/natalia/Escritorio/apuntes-privados"
PUERTO_WEB=3000

# ============================================================
# FUENTE DE LAS ASIGNATURAS Y APUNTES
# Opciones:
# - "github": lee las asignaturas, temas y apuntes de GitHub (nataliagamezbarea/GRADOS_INFORMATICOS)
# - "local": lee las asignaturas de la ruta local (DIRECTORIO_APUNTES)
# - "auto": intenta local y si no existe o no tiene temas, usa GitHub
# ============================================================
FUENTE_ASIGNATURAS="github"

# ============================================================
# PROVEEDOR DE INTELIGENCIA ARTIFICIAL (IA)
# Opciones: "auto" (prueba Ollama primero y fallback a NVIDIA), "ollama" o "nvidia"
# ============================================================
PROVEEDOR_IA="nvidia"

# Modelo local de Ollama (para desarrollo en tu máquina)
MODELO_IA=qwen2.5vl:7b
NUM_CTX_IA=24576
TOKENS_MAX_IA=2048
TIEMPO_IA=900
MAX_CARACTERES_BLOQUE=10000

# ============================================================
# NVIDIA NIM (build.nvidia.com) - Gratuito (~40 req/min)
# Más de 120 modelos abiertos: Nemotron, DeepSeek R1, Llama 3.1, Qwen 2.5, etc.
# Funciona en desarrollo y desplegado en web / GitHub sin depender de Ollama local
# ============================================================
NVIDIA_API_KEY=""
NVIDIA_MODELO="nvidia/nemotron-3.5-bolt-e4b"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# ============================================================
# SUPABASE (Mismo proyecto que Acceso Grados Informáticos)
# ============================================================
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="tu-clave-anon-supabase"

# ============================================================
# GITHUB (Repositorio con las preguntas y apuntes)
# ============================================================
GITHUB_REPOSITORY="nataliagamezbarea/GRADOS_INFORMATICOS"
GITHUB_BRANCH="master"
GITHUB_TEST_DIR="test"
GITHUB_APUNTES_DIR="apuntes_privados"

# Token de acceso personal de GitHub (si se deja vacío, usa gh auth token automáticamente)
GH_TOKEN=""
