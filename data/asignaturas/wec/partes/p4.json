  {
    "id": 66,
    "tema": 2,
    "tipo": "codigo",
    "tag": "Operadores ++ y --",
    "dificultad": "dificil",
    "enunciado": "¿Qué imprime este código?",
    "codigo": "let a = 1;\nlet z = 10;\nz = a;\nz = ++a;\nz = a++;\nconsole.log(a, z);",
    "opciones": {
      "A": "2 2",
      "B": "3 2",
      "C": "2 3",
      "D": "3 3"
    },
    "correcta": "B",
    "explicacion": "z = a → 1; ++a → a = 2, z = 2; a++ → z = 2, a = 3. Al final a = 3 y z = 2.",
    "traza": [
      {
        "linea": 1,
        "vars": {
          "a": 1
        },
        "nota": "Se declara a y se inicializa a 1."
      },
      {
        "linea": 2,
        "vars": {
          "a": 1,
          "z": 10
        },
        "nota": "Se declara z y se inicializa a 10."
      },
      {
        "linea": 3,
        "vars": {
          "a": 1,
          "z": 1
        },
        "nota": "z = a: z toma el valor actual de a, que es 1."
      },
      {
        "linea": 4,
        "vars": {
          "a": 2,
          "z": 2
        },
        "nota": "++a: primero incrementa a a 2 y después asigna el valor ya incrementado a z."
      },
      {
        "linea": 5,
        "vars": {
          "a": 3,
          "z": 2
        },
        "nota": "a++: primero asigna el valor actual (2) a z y después incrementa a a 3."
      },
      {
        "linea": 6,
        "vars": {
          "a": 3,
          "z": 2
        },
        "nota": "console.log(a, z) imprime 3 2.",
        "salida": "3 2"
      }
    ]
  },
