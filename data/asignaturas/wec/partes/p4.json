    "dificultad": "dificil",
    "enunciado": "¿Qué ocurre al ejecutar este código?",
    "codigo": "{\n  let dedins = \"solo dentro\";\n  console.log(dedins);\n}\nconsole.log(dedins);",
    "opciones": {
      "A": "No imprime nada",
      "B": "Imprime \"solo dentro\" dos veces",
      "C": "Imprime \"solo dentro\" y luego lanza ReferenceError: dedins is not defined",
      "D": "Lanza SyntaxError en la primera línea"
    },
    "correcta": "C",
    "explicacion": "let tiene ámbito de bloque: solo existe entre sus llaves. Dentro funciona; fuera, la variable no existe y se lanza ReferenceError.",
    "traza": [
      {
        "linea": 1,
        "vars": {},
        "nota": "Empieza el bloque."
      },
      {
        "linea": 2,
        "vars": {
          "dedins": "solo dentro"
        },
        "nota": "dedins nace dentro del bloque."
      },
      {
        "linea": 3,
        "vars": {
          "dedins": "solo dentro"
        },
        "nota": "Dentro del bloque, dedins existe.",
        "salida": "solo dentro"
      },
      {
        "linea": 4,
        "vars": {},
        "nota": "Termina el bloque: dedins deja de existir."
      },
      {
        "linea": 5,
        "vars": {},
        "nota": "Fuera del bloque, dedins no está definido.",
        "error": "ReferenceError: dedins is not defined"
      }
    ]
  },
